+class WT_OT_magic_branch_toggle_active(Operator):
+    bl_idname = 'mesh.wt_magic_branch_toggle_active'
+    bl_label = 'Toggle Magic Branch'
+    bl_description = 'Turn Magic Branch click-drag mode on or off. This operator can be assigned to a Blender hotkey.'
+    bl_options = {'REGISTER'}
+
+    def execute(self, context):
+        global _MAGIC_BRANCH_RUNNING
+        props = context.scene.wt_precision_edit
+        if props.magic_branch_active or _MAGIC_BRANCH_RUNNING:
+            props.magic_branch_active = False
+            props.magic_branch_last_report = 'Magic Branch turning off.'
+            return {'FINISHED'}
+        props.magic_branch_active = True
+        try:
+            result = bpy.ops.mesh.wt_magic_branch('INVOKE_DEFAULT')
+        except Exception as error:
+            props.magic_branch_active = False
+            self.report({'ERROR'}, f'Could not start Magic Branch: {error}')
+            return {'CANCELLED'}
+        if 'CANCELLED' in result:
+            props.magic_branch_active = False
+            return {'CANCELLED'}
+        return {'FINISHED'}
+
