+import bmesh
+import bpy
+from bpy.types import Operator
+from mathutils import Vector
+
+ANCHOR_LAYER = 'wt_align_target_anchor'
+
+
+def _edit_mesh_objects(context):
+    objects = list(getattr(context, 'objects_in_mode_unique_data', ()) or ())
+    active = getattr(context, 'active_object', None)
+    if active and active.type == 'MESH' and active not in objects:
+        objects.insert(0, active)
+    return [obj for obj in objects if obj and obj.type == 'MESH' and obj.mode == 'EDIT']
+
+
+def _selected_vertices(bm):
+    verts = {vert for vert in bm.verts if vert.select}
+    for edge in bm.edges:
+        if edge.select:
+            verts.update(edge.verts)
+    for face in bm.faces:
+        if face.select:
+            verts.update(face.verts)
+    return list(verts)
+
+
+def _history_vertices(bm):
+    active = bm.select_history.active
+    if isinstance(active, bmesh.types.BMVert):
+        return [active]
+    if isinstance(active, bmesh.types.BMEdge):
+        return list(active.verts)
+    if isinstance(active, bmesh.types.BMFace):
+        return list(active.verts)
+    return []
+
+
+def _world_median(obj, verts):
+    total = Vector((0.0, 0.0, 0.0))
+    for vert in verts:
+        total += obj.matrix_world @ vert.co
+    return total / len(verts)
+
+
+def _shape_key_problem(obj):
+    keys = getattr(obj.data, 'shape_keys', None)
+    return bool(keys and len(keys.key_blocks) > 1)
+
+
+def _selected_components(selected):
+    selected_set = set(selected)
+    components = []
+    unseen = set(selected_set)
+    while unseen:
+        seed = unseen.pop()
+        component = {seed}
+        stack = [seed]
+        while stack:
+            vert = stack.pop()
+            for edge in vert.link_edges:
+                other = edge.other_vert(vert)
+                if other in unseen and other in selected_set:
+                    unseen.remove(other)
+                    component.add(other)
+                    stack.append(other)
+        components.append(component)
+    return components
+
+
+def _axis_mask(props):
+    return (props.align_selection_use_x, props.align_selection_use_y, props.align_selection_use_z)
+
+
+def _source_vector(props):
+    return Vector(props.align_selection_source_world)
+
+
+class WT_OT_align_capture_source(Operator):
+    bl_idname = 'mesh.wt_align_capture_source'
+    bl_label = 'Capture Align Source'
+    bl_description = 'Capture the world-space coordinate of the selected source vertex, edge, face, or selection'
+    bl_options = {'REGISTER', 'UNDO'}
+
+    @#classmethod
+    def poll(cls, context):
+        return context.mode == 'EDIT_MESH'
+
+    def execute(self, context):
+        props = context.scene.witch_tools
+        points = []
+        for obj in _edit_mesh_objects(context):
+            bm = bmesh.from_edit_mesh(obj.data)
+            bm.verts.ensure_lookup_table()
+            verts = _history_vertices(bm) if props.align_selection_reference_mode == 'ACTIVE' else _selected_vertices(bm)
+            if verts:
+                if props.align_selection_reference_mode == 'ACTIVE':
+                    props.align_selection_source_world = _world_median(obj, verts)
+                    props.align_selection_has_source = True
+                    props.align_selection_source_label = f'{obj.name}: active {len(verts)} vert(s)'
+                    self.report(x'INFO'}, 'Align source captured')
+                    return x'FINISHED'}
+                points.extend(obj.matrix_world @ vert.co for vert in verts)
+        if not points:
+            self.report({'ERROR'}, 'Select source geometry in mesh Edit Mode')
+            return {'CANCELLED'}
+        value = sum(points, Vector()) / len(points)
+        props.align_selection_source_world = value
+        props.align_selection_has_source = True
+        props.align_selection_source_label = f'Median of {len(points)} vert(s)'
+        self.report({'INFO'}, f'Align source captured from {len(points)} vertices')
+        return {'FINISHED'}
+
+
+class WT_OT_align_capture_targets(Operator):
+    bl_idname = 'mesh.wt_align_capture_targets'
+    bl_label = 'Capture Target Anchor'
+    bl_description = 'Mark the selected geometry as the target anchor for preserve-shape alignment'
+    bl_options = {'REGISTER', 'UNDO'}
+
+    @#classmethod
+    def poll(cls, context):
+        return context.mode == 'EDIT_MESH'
+
+    def execute(self, context):
+        total = 0
+        objects = _edit_mesh_objects(context)
+        for obj in objects:
+            bm = bmesh.from_edit_mesh(obj.data)
+            layer = bm.verts.layers.int.get(ANCHOR_LAYER) or bm.verts.layers.int.new(ANCHOR_LAYER)
+            for vert in bm.verts:
+                vert[layer] = 0
+            selected = _selected_vertices(bm)
+            for vert in selected:
+                vert[layer] = 1
+            total += len(selected)
+            bmesh.update_edit_mesh(obj.data, loop_triangles=False, destructive=False)
+        if not total:
+            self.report({'ERROR'}, 'Select one or more target-anchor vertices, edges, or faces')
+            return {'CANCELLED'}
+        context.scene.witch_tools.align_selection_has_targets = True
+        self.report({'INFO'}, f'Captured {total} target-anchor vertices')
+        return {'FINISHED'}
+
+
+class WT_OT_align_clear(Operator):
+    bl_idname = 'mesh.wt_align_clear'
+    bl_label = 'Clear Align Selection'
+    bl_options = {'REGISTER', 'UNDO'}
+    def execute(self, context):
+        props = context.scene.witch_tools
+        props.align_selection_has_source = False
+        props.align_selection_has_targets = False
+        props.align_selection_source_label = ''
+        for obj in _edit_mesh_objects(context):
+            bm = bmesh.from_edit_mesh(obj.data)
+            layer = bm.verts.layers.int.get(ANCHOR_LAYER)
+            if layer:
+                for vert in bm.verts:
+                    vert[layer] = 0
+                bmesh.update_edit_mesh(obj.data, loop_triangles=False, destructive=False)
+        return {'FINISHED'}
+
+
+class WT_OT_align_apply(Operator):
+    bl_idname = 'mesh.wt_align_apply'
+    bl_label = 'Apply Align Selection'
+    bl_description = 'Match coordinates or translate selected geometry while preserving its shape'
+    bl_options = {'REGISTER', 'UNDO'}
